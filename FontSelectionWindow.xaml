<Window x:Class="DesktopNotes.FontSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Տառատեսակ"
        Width="460"
        Height="340"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                Background="White"
                CornerRadius="3"
                Padding="16,14">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Տառատեսակի ընտանիք -->
                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Տառատեսակի ընտանիք՝"
                               FontSize="12"
                               VerticalAlignment="Center"/>

                    <ComboBox x:Name="FontFamilyComboBox"
                              Grid.Row="0"
                              Grid.Column="1"
                              Height="26"
                              FontSize="12"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="Input_Changed"/>

                    <!-- Կետաչափ -->
                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="Կետաչափ՝"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,10,0,0"/>

                    <TextBox x:Name="FontSizeTextBox"
                             Grid.Row="1"
                             Grid.Column="1"
                             Width="80"
                             Height="26"
                             FontSize="12"
                             Padding="6,2"
                             HorizontalAlignment="Left"
                             Text="14"
                             Margin="0,10,0,0"
                             TextChanged="Input_Changed"/>

                    <!-- Ոճ -->
                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="Ոճ՝"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,10,0,0"/>

                    <ComboBox x:Name="FontStyleComboBox"
                              Grid.Row="2"
                              Grid.Column="1"
                              Width="140"
                              Height="26"
                              FontSize="12"
                              HorizontalAlignment="Left"
                              SelectedIndex="0"
                              Margin="0,10,0,0"
                              SelectionChanged="Input_Changed">
                        <ComboBoxItem Content="Սովորական"/>
                        <ComboBoxItem Content="Թավ"/>
                        <ComboBoxItem Content="Շեղ"/>
                        <ComboBoxItem Content="Թավ Շեղ"/>
                    </ComboBox>
                </Grid>

                <Separator Margin="0,4,0,10" Background="#EBEBEB"/>

                <!-- Նախադիտում -->
                <TextBlock Text="Նախադիտում՝"
                           FontSize="11"
                           Foreground="#777777"
                           Margin="0,0,0,4"/>

                <Border BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        Background="#FAFAFA"
                        CornerRadius="2"
                        Height="50"
                        Padding="8,4">
                    <TextBlock x:Name="PreviewTextBlock"
                               Text="Աա Բբ Գգ 123 Փորձնական"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Կոճակներ -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="OkButton"
                    Grid.Column="1"
                    Content="Լավ"
                    Width="85"
                    Height="28"
                    IsDefault="True"
                    Click="OkButton_Click"/>

            <Button x:Name="CancelButton"
                    Grid.Column="3"
                    Content="Չեղարկել"
                    Width="85"
                    Height="28"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
        </Grid>
    </Grid>
</Window>
