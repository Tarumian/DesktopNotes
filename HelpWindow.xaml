<Window x:Class="DesktopNotes.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Օգնություն"
        Width="640"
        Height="540"
        MinWidth="500"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F7F7F7">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Վերնագիր -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16,12"
                Margin="0,0,0,12">
            <TextBlock Text="Օգտագործման ուղեցույց եւ ստեղնաշարային համադրություններ"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="#222222"/>
        </Border>

        <!-- Ուղեցույցի բովանդակություն -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16,14"
                Margin="0,0,0,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel TextElement.FontSize="13" TextElement.Foreground="#333333">

                    <!-- 1. Հիմնական գործողություններ -->
                    <TextBlock Text="1. Հիմնական գործողություններ"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="#1976D2"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="• Նոր թերթիկ՝ Սեղմեք թերթիկի վերեւի «+» կոճակը կամ սեղմեք Ctrl+N:"
                               Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <TextBlock Text="• Ջնջել թերթիկը՝ Սեղմեք «−» կոճակը (հետարկելի է Ctrl+Z-ով):"
                               Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <TextBlock Text="• Նշել որպես լուծված՝ Սեղմեք «✓» կոճակը:"
                               Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <TextBlock Text="• Տեղափոխում եւ Պտտում՝ Քաշեք թերթիկի վերին գոտուց՝ տեղափոխելու համար, կամ եզրային հատվածներից՝ ազատ անկյան տակ պտտելու համար:"
                               Margin="0,0,0,12" TextWrapping="Wrap"/>

                    <!-- 2. Գործիքներ եւ մատիտ -->
                    <TextBlock Text="2. Գործիքներ եւ Մատիտ"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="#1976D2"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="• Մատիտով նկարել՝ Սեղմեք արագ վահանակի մատիտի կոճակը կամ Ctrl+P:"
                               Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <TextBlock Text="• Ռետին (մաքրել գծերը)՝ Մատիտի ռեժիմում պահեք Ctrl ստեղնը եւ քաշեք ջնջվող գծերի վրայով:"
                               Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <TextBlock Text="• Ձեւավորում՝ Արագ վահանակից կարող եք փոխել տեքստի թավությունը (Թ), շեղությունը (Շ), գույնը, տառաչափը եւ տողամիջոցը:"
                               Margin="0,0,0,12" TextWrapping="Wrap"/>

                    <!-- 3. Տրցակներ -->
                    <TextBlock Text="3. Տրցակներ (Stacks)"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="#1976D2"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="• Թերթիկները միմյանց վրա դնելիս նրանք ավտոմատ միավորվում են մեկ տրցակի մեջ:"
                               Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <TextBlock Text="• Տրցակի միջով կարելի է թերթել վերեւի սլաքներով կամ անիվով:"
                               Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <TextBlock Text="• Թերթիկը տրցակից առանձնացնելու համար կարող եք ընտրել տեղային ցանկի «Հեռացնել տրցակից» հրամանը:"
                               Margin="0,0,0,12" TextWrapping="Wrap"/>

                    <!-- 4. Ստեղնաշարային համադրություններ -->
                    <TextBlock Text="4. Ստեղնաշարային համադրություններ"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="#1976D2"
                               Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl + N" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Ստեղծել նոր թերթիկ"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl + F" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Որոնել թերթիկների մեջ" Margin="0,4,0,0"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl + P" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Միացնել / անջատել մատիտը" Margin="0,4,0,0"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Ctrl + Z" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Հետարկել (Undo)" Margin="0,4,0,0"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Ctrl + Y" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="Վերարկել (Redo)" Margin="0,4,0,0"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Ctrl + W" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="Փակել ընթացիկ թերթիկը" Margin="0,4,0,0"/>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Փակել կոճակ -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Փակել"
                    Width="90"
                    Height="28"
                    IsDefault="True"
                    IsCancel="True"
                    Background="#FFFFFF"
                    BorderBrush="#C5C5C5"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
