<Window x:Class="Hushak.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Hushak"
        Title="{loc:Loc HelpTitle}"
        Width="640"
        Height="540"
        MinWidth="500"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F7F7F7">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Վերնագիր -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16,12"
                Margin="0,0,0,12">
            <TextBlock Text="{loc:Loc HelpHeader}"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="#222222"/>
        </Border>

        <!-- Ուղեցույցի բովանդակություն -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16,14"
                Margin="0,0,0,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel TextElement.FontSize="13" TextElement.Foreground="#333333">

                    <!-- 1. Հիմնական գործողություններ -->
                    <TextBlock Text="{loc:Loc HelpSec1Title}"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="#1976D2"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="{loc:Loc HelpSec1_1}"
                               Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <TextBlock Text="{loc:Loc HelpSec1_2}"
                               Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <TextBlock Text="{loc:Loc HelpSec1_3}"
                               Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <TextBlock Text="{loc:Loc HelpSec1_4}"
                               Margin="0,0,0,12" TextWrapping="Wrap"/>

                    <!-- 2. Գործիքներ եւ մատիտ -->
                    <TextBlock Text="{loc:Loc HelpSec2Title}"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="#1976D2"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="{loc:Loc HelpSec2_1}"
                               Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <TextBlock Text="{loc:Loc HelpSec2_2}"
                               Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <TextBlock Text="{loc:Loc HelpSec2_3}"
                               Margin="0,0,0,12" TextWrapping="Wrap"/>

                    <!-- 3. Տրցակներ -->
                    <TextBlock Text="{loc:Loc HelpSec3Title}"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="#1976D2"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="{loc:Loc HelpSec3_1}"
                               Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <TextBlock Text="{loc:Loc HelpSec3_2}"
                               Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <TextBlock Text="{loc:Loc HelpSec3_3}"
                               Margin="0,0,0,12" TextWrapping="Wrap"/>

                    <!-- 4. Ստեղնաշարային համադրություններ -->
                    <TextBlock Text="{loc:Loc HelpSec4Title}"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="#1976D2"
                               Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl + N" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{loc:Loc KeyNewNote}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl + F" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{loc:Loc KeySearch}" Margin="0,4,0,0"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl + P" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{loc:Loc KeyPencil}" Margin="0,4,0,0"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Ctrl + Z" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{loc:Loc KeyUndo}" Margin="0,4,0,0"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Ctrl + Y" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{loc:Loc KeyRedo}" Margin="0,4,0,0"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Ctrl + W" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{loc:Loc KeyClose}" Margin="0,4,0,0"/>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Փակել կոճակ -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="{loc:Loc Close}"
                    Width="90"
                    Height="28"
                    IsDefault="True"
                    IsCancel="True"
                    Background="#FFFFFF"
                    BorderBrush="#C5C5C5"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
