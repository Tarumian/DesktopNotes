<Window x:Class="DesktopNotes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Note"
        Width="340"
        Height="260"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True">

    <Grid x:Name="MainGrid">

        <!-- ===================================================== -->
        <!-- ՀՐԱՄԱՆԱՑԱՆԿ -->
        <!-- ===================================================== -->

        <Grid.ContextMenu>
            <ContextMenu x:Name="NoteContextMenu"
                         Opened="NoteContextMenu_Opened">

                <MenuItem Header="Նոր թերթիկ"
                          Click="NewNote_Click"/>

                <Separator/>

                <MenuItem Header="Տառատեսակ">
                    <MenuItem Header="Arial"
                              Click="FontArial_Click"/>
                    <MenuItem Header="Times New Roman"
                              Click="FontTimes_Click"/>
                    <MenuItem Header="Courier New"
                              Click="FontCourier_Click"/>
                </MenuItem>

                <MenuItem Header="Կետաչափ">
                    <MenuItem Header="14"
                              Click="FontSize14_Click"/>
                    <MenuItem Header="16"
                              Click="FontSize16_Click"/>
                    <MenuItem Header="18"
                              Click="FontSize18_Click"/>
                    <MenuItem Header="20"
                              Click="FontSize20_Click"/>
                    <MenuItem Header="24"
                              Click="FontSize24_Click"/>
                    <MenuItem Header="28"
                              Click="FontSize28_Click"/>
                </MenuItem>

                <MenuItem Header="Ոճ">
                    <MenuItem Header="Թավ"
                              Click="Bold_Click"/>
                    <MenuItem Header="Շեղ"
                              Click="Italic_Click"/>
                    <MenuItem Header="Թավ շեղ"
                              Click="BoldItalic_Click"/>
                    <MenuItem Header="Սովորական"
                              Click="Normal_Click"/>
                </MenuItem>

                <Separator/>

                <MenuItem Header="Փակել"
                          Click="CloseMenu_Click"/>

            </ContextMenu>
        </Grid.ContextMenu>


        <!-- ===================================================== -->
        <!-- ԹԵՐԹԻԿ -->
        <!-- ===================================================== -->

        <Border x:Name="Note"
                Width="300"
                Height="220"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#FFF59D"
                CornerRadius="3"
                BorderBrush="#D8C95A"
                BorderThickness="1"

                MouseEnter="Note_MouseEnter"
                MouseLeave="Note_MouseLeave"
                MouseLeftButtonDown="Note_MouseLeftButtonDown"
                MouseMove="Note_MouseMove"
                MouseLeftButtonUp="Note_MouseLeftButtonUp"
                MouseRightButtonDown="Note_MouseRightButtonDown">

            <Border.RenderTransform>
                <RotateTransform x:Name="NoteRotation"
                                 Angle="0"/>
            </Border.RenderTransform>

            <Border.RenderTransformOrigin>
                <Point X="0.5"
                       Y="0.5"/>
            </Border.RenderTransformOrigin>

            <Border.Effect>
                <DropShadowEffect BlurRadius="12"
                                  ShadowDepth="4"
                                  Opacity="0.35"/>
            </Border.Effect>


            <Grid>

                <!-- ================================================= -->
                <!-- ՎԵՐԵՒԻ ՏԵՂԱՓՈԽՄԱՆ ԳՈՏԻ -->
                <!-- ================================================= -->

                <Border x:Name="MoveArea"
                        Height="18"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        Cursor="SizeAll"
                        MouseLeftButtonDown="MoveArea_MouseLeftButtonDown"/>


                <!-- ================================================= -->
                <!-- ՏԵՔՍՏ -->
                <!-- ================================================= -->

                <RichTextBox x:Name="NoteText"
                             Width="250"
                             Height="150"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Margin="18,36,0,0"
                             FontFamily="Arial"
                             FontSize="18"
                             Foreground="#222222"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             AcceptsReturn="True"
                             Cursor="IBeam"
                             ContextMenu="{x:Null}"
                             MouseRightButtonDown="NoteText_MouseRightButtonDown"/>


                <!-- ================================================= -->
                <!-- ՓԱԿԵԼՈՒ × -->
                <!-- ================================================= -->

                <Button x:Name="CloseButton"
                        Content="×"
                        Width="25"
                        Height="25"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,-8,-5,0"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="#555555"
                        Background="Transparent"
                        BorderThickness="0"
                        Visibility="Collapsed"
                        IsHitTestVisible="True"
                        MouseEnter="CloseButton_MouseEnter"
                        MouseLeave="CloseButton_MouseLeave"
                        Click="CloseButton_Click"
                        ToolTip="Փակել թերթիկը"/>


                <!-- ================================================= -->
                <!-- ՆԱԽՈՐԴ ԹԵՐԹԻԿ -->
                <!-- ================================================= -->

                <Button x:Name="PreviousButton"
                        Content="‹"
                        Width="28"
                        Height="28"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="4,0,0,4"
                        FontSize="24"
                        Foreground="#777777"
                        Background="Transparent"
                        BorderThickness="0"
                        Visibility="Collapsed"
                        Cursor="Hand"
                        Click="PreviousButton_Click"
                        ToolTip="Նախորդ թերթիկ"/>


                <!-- ================================================= -->
                <!-- ՀԱՋՈՐԴ ԹԵՐԹԻԿ -->
                <!-- ================================================= -->

                <Button x:Name="NextButton"
                        Content="›"
                        Width="28"
                        Height="28"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,4,4"
                        FontSize="24"
                        Foreground="#777777"
                        Background="Transparent"
                        BorderThickness="0"
                        Visibility="Collapsed"
                        Cursor="Hand"
                        Click="NextButton_Click"
                        ToolTip="Հաջորդ թերթիկ"/>

            </Grid>

        </Border>

    </Grid>
</Window>