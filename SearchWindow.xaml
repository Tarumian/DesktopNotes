<Window x:Class="DesktopNotes.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Որոնել թերթիկներ"
        Width="720"
        Height="550"
        MinWidth="600"
        MinHeight="450"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Grid Margin="18">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================================ -->
        <!-- ԲԱՆԱԼԻ ԲԱՌ -->
        <!-- ================================ -->

        <TextBlock Grid.Row="0"
                   Text="Բանալի բառ"
                   FontSize="14"
                   Margin="0,0,0,5"/>

        <TextBox x:Name="KeywordTextBox"
                 Grid.Row="1"
                 Height="26"
                 FontSize="12"
                 Padding="7,2"
                 Margin="0,0,0,14"
                 TextChanged="KeywordTextBox_TextChanged"/>

        <!-- ================================ -->
        <!-- ՍՏԵՂԾՄԱՆ ԱՄՍԱԹԻՎ -->
        <!-- ================================ -->

        <TextBlock Grid.Row="2"
                   Text="Ստեղծման ամսաթիվ"
                   FontSize="14"
                   Margin="0,0,0,5"/>

        <Grid Grid.Row="3"
              Margin="0,0,0,14">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="35"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Սկսած՝"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>

            <DatePicker x:Name="CreatedFromPicker"
                        Grid.Column="1"
                        Height="26"
                        SelectedDateChanged="CreatedDatePicker_SelectedDateChanged"/>

            <TextBlock Grid.Column="2"
                       Text="—"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Column="3"
                       Text="Մինչեւ՝"
                       VerticalAlignment="Center"
                       Margin="8,0,8,0"/>

            <DatePicker x:Name="CreatedToPicker"
                        Grid.Column="4"
                        Height="26"
                        SelectedDateChanged="CreatedDatePicker_SelectedDateChanged"/>

        </Grid>

        <!-- ================================ -->
        <!-- ԼՈՒԾՄԱՆ ԱՄՍԱԹԻՎ -->
        <!-- ================================ -->

        <TextBlock Grid.Row="4"
                   Text="Լուծման ամսաթիվ"
                   FontSize="14"
                   Margin="0,0,0,5"/>

        <Grid Grid.Row="6"
      Height="280"
      VerticalAlignment="Top">

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Ամսաթվերի դաշտեր -->
    <Grid Grid.Row="0"
          Margin="0,0,0,6">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="35"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                   Text="Սկսած՝"
                   VerticalAlignment="Center"
                   Margin="0,0,8,0"/>

        <DatePicker x:Name="CompletedFromPicker"
                    Grid.Column="1"
                    Height="26"
                    SelectedDateChanged="CompletedDatePicker_SelectedDateChanged"/>

        <TextBlock Grid.Column="2"
                   Text="—"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

        <TextBlock Grid.Column="3"
                   Text="Մինչեւ՝"
                   VerticalAlignment="Center"
                   Margin="8,0,8,0"/>

        <DatePicker x:Name="CompletedToPicker"
                    Grid.Column="4"
                    Height="26"
                    SelectedDateChanged="CompletedDatePicker_SelectedDateChanged"/>

    </Grid>

    <!-- Ամսաթվի մաքրման հուշում -->
    <TextBlock Grid.Row="1"
               Text="Ամսաթիվը մաքրելու համար սեղմեք Del։"
               FontSize="11"
               Foreground="#777777"
               Margin="0,0,0,16"/>

    <!-- Արդյունքներ -->
    <Border Grid.Row="2"
            BorderBrush="#D0D0D0"
            BorderThickness="1"
            Background="White"
            CornerRadius="3">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="ResultCountText"
                       Grid.Row="0"
                       Text="Գտնված է՝ 0"
                       FontSize="13"
                       Foreground="#666666"
                       Margin="10,8"/>

            <ListBox x:Name="ResultsListBox"
                        Grid.Row="1"
                        BorderThickness="0"
                        Padding="4"
                        MouseDoubleClick="ResultsListBox_MouseDoubleClick"/>

        </Grid>

    </Border>

</Grid>

        <!-- ================================ -->
        <!-- ՆԵՐՔԵՒԻ ԿՈՃԱԿՆԵՐ -->
        <!-- ================================ -->

        <Grid Grid.Row="7"
              Margin="0,6,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="OpenUncompletedButton"
                    Grid.Column="0"
                    Content="Բացել չլուծված բոլոր թերթիկները"
                    HorizontalAlignment="Left"
                    Height="30"
                    Padding="12,0"
                    FontSize="13"
                    Background="Transparent"
                    BorderThickness="1"
                    Click="OpenUncompletedButton_Click"/>

            <Button x:Name="ClearButton"
                    Grid.Column="1"
                    Content="Մաքրել"
                    Width="80"
                    Height="30"
                    Click="ClearButton_Click"/>

            <Button x:Name="CloseButton"
                    Grid.Column="3"
                    Content="Փակել"
                    Width="80"
                    Height="30"
                    Click="CloseButton_Click"/>

        </Grid>

    </Grid>
</Window>