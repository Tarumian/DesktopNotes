<Window x:Class="DesktopNotes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Note"
        Width="500"
        Height="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        MouseEnter="NoteWindow_MouseEnter"
        MouseLeave="NoteWindow_MouseLeave">

    <Grid x:Name="MainGrid">

        <!-- ===================================================== -->
        <!-- ՀՐԱՄԱՆԱՑԱՆԿ -->
        <!-- ===================================================== -->

        <Grid.ContextMenu>
            <ContextMenu x:Name="NoteContextMenu"
                         Opened="NoteContextMenu_Opened">

                <MenuItem Header="Նոր թերթիկ"
                          Click="NewNote_Click"/>

                <Separator/>

                <MenuItem Header="Տառատեսակ">
                    <MenuItem Header="Arial"
                              Click="FontArial_Click"/>
                    <MenuItem Header="Times New Roman"
                              Click="FontTimes_Click"/>
                    <MenuItem Header="Courier New"
                              Click="FontCourier_Click"/>
                </MenuItem>

                <MenuItem Header="Կետաչափ">
                    <MenuItem Header="14"
                              Click="FontSize14_Click"/>
                    <MenuItem Header="16"
                              Click="FontSize16_Click"/>
                    <MenuItem Header="18"
                              Click="FontSize18_Click"/>
                    <MenuItem Header="20"
                              Click="FontSize20_Click"/>
                    <MenuItem Header="24"
                              Click="FontSize24_Click"/>
                    <MenuItem Header="28"
                              Click="FontSize28_Click"/>
                </MenuItem>

                <MenuItem Header="Ոճ">
                    <MenuItem Header="Թավ"
                              Click="Bold_Click"/>
                    <MenuItem Header="Շեղ"
                              Click="Italic_Click"/>
                    <MenuItem Header="Թավ շեղ"
                              Click="BoldItalic_Click"/>
                    <MenuItem Header="Սովորական"
                              Click="Normal_Click"/>
                </MenuItem>

                <MenuItem Header="Տեքստի գույն">
                    <MenuItem Header="Սեւ"
                              Click="TextBlack_Click"/>
                    <MenuItem Header="Մուգ մոխրագույն"
                              Click="TextDarkGray_Click"/>
                    <MenuItem Header="Կարմիր"
                              Click="TextRed_Click"/>
                    <MenuItem Header="Կապույտ"
                              Click="TextBlue_Click"/>
                    <MenuItem Header="Կանաչ"
                              Click="TextGreen_Click"/>
                    <MenuItem Header="Շագանակագույն"
                              Click="TextBrown_Click"/>
                </MenuItem>

                <MenuItem Header="Չափ">
                    <MenuItem Header="150 × 220"
                              Click="Size150x220_Click"/>
                    <MenuItem Header="300 × 220"/>
                    <MenuItem Header="150 × 450"/>
                </MenuItem>

                <Separator/>

<MenuItem Header="Արտահանել Excel"
          Click="ExportExcel_Click"/>

<MenuItem x:Name="UndoDeleteMenuItem"
          Header="Հետարկել ջնջումը"
          Click="UndoDelete_Click"
          IsEnabled="False"/>

<MenuItem Header="Փակել"
          Click="CloseMenu_Click"/>

            </ContextMenu>
        </Grid.ContextMenu>


        <!-- ===================================================== -->
        <!-- ԹԵՐԹԻԿ -->
        <!-- ===================================================== -->

        <Border x:Name="Note"
                Width="300"
                Height="220"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#FFF59D"
                CornerRadius="3"
                BorderBrush="#D8C95A"
                BorderThickness="1"

                MouseEnter="Note_MouseEnter"
                MouseLeave="Note_MouseLeave"
                MouseLeftButtonDown="Note_MouseLeftButtonDown"
                MouseMove="Note_MouseMove"
                MouseLeftButtonUp="Note_MouseLeftButtonUp"
                MouseRightButtonDown="Note_MouseRightButtonDown">

            <Border.RenderTransform>
                <RotateTransform x:Name="NoteRotation"
                                 Angle="0"/>
            </Border.RenderTransform>

            <Border.RenderTransformOrigin>
                <Point X="0.5"
                       Y="0.5"/>
            </Border.RenderTransformOrigin>

            <Border.Effect>
                <DropShadowEffect BlurRadius="12"
                                  ShadowDepth="4"
                                  Opacity="0.35"/>
            </Border.Effect>


            <Grid>

                <!-- ================================================= -->
<!-- ՎԵՐԵՒԻ ՀԻՄՆԱԿԱՆ ԳՈՏԻ -->
<!-- ================================================= -->
<Grid Height="12"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Top">

    <!-- Տեղափոխման գոտի -->
    <Border x:Name="MoveArea"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="Transparent"
            Cursor="SizeAll"
            MouseLeftButtonDown="MoveArea_MouseLeftButtonDown"/>

    <!-- + եւ − -->
    <StackPanel x:Name="EditButtons"
                Orientation="Horizontal"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="0,-7,0,0"
                Visibility="Collapsed">

        <!-- + Նոր թերթիկ -->
        <Button x:Name="NewButton"
                Content="+"
                Width="25"
                Height="25"
                FontSize="18"
                Foreground="#555555"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                FocusVisualStyle="{x:Null}"
                Click="NewNote_Click">

            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </ControlTemplate>
            </Button.Template>

            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Foreground"
                            Value="#555555"/>
                    <Setter Property="FontWeight"
                            Value="Normal"/>

                    <Style.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter Property="Foreground"
                                    Value="Black"/>
                            <Setter Property="FontWeight"
                                    Value="ExtraBold"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- − Ջնջել -->
        <Button x:Name="DeleteButton"
                Content="−"
                Width="25"
                Height="25"
                Margin="-7,0,0,0"
                FontSize="18"
                Foreground="#555555"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                FocusVisualStyle="{x:Null}"
                IsEnabled="True"
                Click="DeleteButton_Click">

            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </ControlTemplate>
            </Button.Template>

            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Foreground"
                            Value="#555555"/>
                    <Setter Property="FontWeight"
                            Value="Normal"/>

                    <Style.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter Property="Foreground"
                                    Value="Black"/>
                            <Setter Property="FontWeight"
                                    Value="ExtraBold"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

<Button x:Name="CompleteButton"
        Content="✓"
        Width="28"
        Height="22"
        FontSize="14"
        Foreground="#555555"
        Background="Transparent"
        BorderThickness="0"
        Padding="0"
        FocusVisualStyle="{x:Null}"
        MouseEnter="CompleteButton_MouseEnter"
        MouseLeave="CompleteButton_MouseLeave"
        Click="CompleteButton_Click"
        ToolTipService.Placement="Mouse"
        ToolTipService.ShowDuration="5000">

    <Button.Template>
        <ControlTemplate TargetType="Button">
            <ContentPresenter
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
        </ControlTemplate>
    </Button.Template>

</Button>

</StackPanel>
</Grid>


<!-- ================================================= -->
<!-- ԵՐԿՐՈՐԴ՝ ԱՐԱԳ ՁԵՒԱՎՈՐՄԱՆ ԳՈՐԾԻՔԱԳՈՏԻ -->
<!-- ================================================= -->

<Border x:Name="QuickToolbar"
        Height="24"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Top"
        Margin="0,12,0,0"
        Background="Transparent"
        Visibility="Collapsed">

    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

        <!-- Թավ -->
        <Button Content="B"
                Width="28"
                Height="22"
                FontSize="14"
                FontWeight="Bold"
                Background="Transparent"
                BorderThickness="0"
                FocusVisualStyle="{x:Null}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Շեղ -->
        <Button Content="I"
                Width="28"
                Height="22"
                FontSize="14"
                FontStyle="Italic"
                Background="Transparent"
                BorderThickness="0"
                FocusVisualStyle="{x:Null}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Տառի գույն -->
        <Button Content="A"
                Width="28"
                Height="22"
                FontSize="14"
                Background="Transparent"
                BorderThickness="0"
                FocusVisualStyle="{x:Null}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Տողամիջոց -->
        <Button Content="↕"
                Width="28"
                Height="22"
                FontSize="14"
                Background="Transparent"
                BorderThickness="0"
                FocusVisualStyle="{x:Null}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Պարբերություն -->
        <Button Content="¶"
                Width="28"
                Height="22"
                FontSize="14"
                Background="Transparent"
                BorderThickness="0"
                FocusVisualStyle="{x:Null}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </ControlTemplate>
            </Button.Template>
        </Button>

    </StackPanel>
</Border>


<!-- ================================================= -->
<!-- ԵՐԿՐՈՐԴ ՀՈՒՎԵՐԱՅԻՆ ԳՈՏԻ -->
<!-- ================================================= -->



                <!-- ================================================= -->
                <!-- ՏԵՔՍՏ -->
                <!-- ================================================= -->

                <RichTextBox x:Name="NoteText"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Margin="12,36,12,12"
             TextChanged="NoteText_TextChanged"
             FontFamily="Comic Sans MS"
             FontSize="14"
             Foreground="#222222"
             Background="Transparent"
             BorderThickness="0"
             Padding="0"
             VerticalScrollBarVisibility="Hidden"
             HorizontalScrollBarVisibility="Hidden"
             AcceptsReturn="True"
             Cursor="IBeam"
             ContextMenu="{x:Null}"
             IsInactiveSelectionHighlightEnabled="True"
             SelectionBrush="#7e8fac"
             SelectionOpacity="0.5"
             MouseRightButtonDown="NoteText_MouseRightButtonDown"
             PreviewMouseLeftButtonDown="NoteText_PreviewMouseLeftButtonDown"
             PreviewMouseMove="NoteText_PreviewMouseMove"
             PreviewMouseLeftButtonUp="NoteText_PreviewMouseLeftButtonUp"/>


                <!-- ================================================= -->
                <!-- ՓԱԿԵԼՈՒ × -->
                <!-- ================================================= -->

                <Button x:Name="CloseButton"
                        Content="×"
                        Width="25"
                        Height="25"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,-8,-5,0"
                        FontSize="18"
                        Foreground="#555555"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        FocusVisualStyle="{x:Null}"
                        Visibility="Collapsed"
                        IsHitTestVisible="True"
                        MouseEnter="CloseButton_MouseEnter"
                        MouseLeave="CloseButton_MouseLeave"
                        Click="CloseButton_Click"
                        ToolTip="Փակել թերթիկը">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </ControlTemplate>
                    </Button.Template>

                    <Button.Style>
                        <Style TargetType="Button">

                            <Setter Property="Foreground"
                                    Value="#555555"/>

                            <Style.Triggers>

                                <Trigger Property="IsMouseOver"
                                         Value="True">

                                    <Setter Property="Foreground"
                                            Value="Black"/>

                                    <Setter Property="FontWeight"
                                            Value="ExtraBold"/>

                                </Trigger>

                            </Style.Triggers>

                        </Style>
                    </Button.Style>

                </Button>

            </Grid>

        </Border>

    </Grid>

</Window>