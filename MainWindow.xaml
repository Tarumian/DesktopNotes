<Window x:Class="DesktopNotes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Note"
        Width="500"
        Height="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        PreviewMouseLeftButtonDown="NoteWindow_PreviewMouseLeftButtonDown"
        PreviewKeyDown="NoteWindow_PreviewKeyDown"
        PreviewKeyUp="NoteWindow_PreviewKeyUp"
        Loaded="QuickToolbar_Loaded"
        MouseEnter="NoteWindow_MouseEnter"
        MouseLeave="NoteWindow_MouseLeave">

    <Grid x:Name="MainGrid">

        <!-- ===================================================== -->
        <!-- ՀՐԱՄԱՆԱՑԱՆԿ -->
        <!-- ===================================================== -->

        <Grid.ContextMenu>
            <ContextMenu x:Name="NoteContextMenu"
                         Opened="NoteContextMenu_Opened">

                <MenuItem Header="Նոր թերթիկ"
                          InputGestureText="Ctrl+N"
                          Click="NewNote_Click"/>

                <MenuItem Header="Որոնել թերթիկներ"
                          InputGestureText="Ctrl+F"
                          Click="SearchNotes_Click"/>

                <MenuItem x:Name="DetachFromStackMenuItem"
                          Header="Հեռացնել տրցակից"
                          Click="DetachFromStackMenu_Click"
                          Visibility="Collapsed"/>

                <Separator/>

                <MenuItem Header="Ուղղահայաց դիրք (0°)"
                          Click="ResetRotationZero_Click"/>

                <MenuItem Header="Պտտման կետ">
                    <MenuItem x:Name="RotationOriginTopCenterMenuItem"
                              Header="Վերեւի մեջտեղ (գամի կետ)"
                              Click="RotationOriginTopCenter_Click"/>
                    <MenuItem x:Name="RotationOriginTopLeftMenuItem"
                              Header="Ձախ վերեւի անկյուն"
                              Click="RotationOriginTopLeft_Click"/>
                </MenuItem>

                <MenuItem x:Name="PinMenuItem"
                          Header="Գամել ամենավերեւում"
                          Click="TogglePin_Click"/>

                <Separator/>

                <MenuItem x:Name="PencilMenuItem"
                          Header="Մատիտ"
                          InputGestureText="Ctrl+P"
                          Click="TogglePencil_Click"/>

                <Separator/>

                <MenuItem Header="Տառատեսակ">
                    <MenuItem Header="Comic Sans MS"
                              Click="FontComicSans_Click"/>
                    <MenuItem Header="Calibri"
                              Click="FontCalibri_Click"/>
                    <MenuItem Header="Courier New"
                              Click="FontCourier_Click"/>
                    <MenuItem Header="Arial"
                              Click="FontArial_Click"/>
                    <MenuItem Header="Times New Roman"
                              Click="FontTimes_Click"/>
                    <MenuItem Header="Այլ..."
                              Click="FontCustom_Click"/>
                </MenuItem>
                <MenuItem Header="Թերթիկի գույն">
                    <MenuItem StaysOpenOnClick="False" FocusVisualStyle="{x:Null}">
                        <MenuItem.Template>
                            <ControlTemplate TargetType="MenuItem">
                                <Border Background="White"
                                        Padding="6"
                                        CornerRadius="3"
                                        BorderBrush="#D0D0D0"
                                        BorderThickness="1">
                                    <WrapPanel Width="120"
                                               Orientation="Horizontal"
                                               HorizontalAlignment="Center">
                                        <Border Width="24" Height="24" Margin="3" CornerRadius="3" Background="#FFF59D" BorderBrush="#B0B0B0" BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="NoteColorSwatch_Click" Tag="#FFF59D" ToolTip="Դեղին"/>
                                        <Border Width="24" Height="24" Margin="3" CornerRadius="3" Background="#C8E6C9" BorderBrush="#B0B0B0" BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="NoteColorSwatch_Click" Tag="#C8E6C9" ToolTip="Կանաչ"/>
                                        <Border Width="24" Height="24" Margin="3" CornerRadius="3" Background="#BBDEFB" BorderBrush="#B0B0B0" BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="NoteColorSwatch_Click" Tag="#BBDEFB" ToolTip="Կապույտ"/>
                                        <Border Width="24" Height="24" Margin="3" CornerRadius="3" Background="#F8BBD0" BorderBrush="#B0B0B0" BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="NoteColorSwatch_Click" Tag="#F8BBD0" ToolTip="Վարդագույն"/>
                                        <Border Width="24" Height="24" Margin="3" CornerRadius="3" Background="#E1BEE7" BorderBrush="#B0B0B0" BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="NoteColorSwatch_Click" Tag="#E1BEE7" ToolTip="Մանուշակագույն"/>
                                        <Border Width="24" Height="24" Margin="3" CornerRadius="3" Background="#FFFFFF" BorderBrush="#B0B0B0" BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="NoteColorSwatch_Click" Tag="#FFFFFF" ToolTip="Սպիտակ"/>
                                        <Border Width="24" Height="24" Margin="3" CornerRadius="3" Background="#F5F5F5" BorderBrush="#999999" BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="NoteColorCustom_Click" ToolTip="Այլ գույն...">
                                            <TextBlock Text="+" FontSize="14" FontWeight="Bold" Foreground="#555555" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                        </Border>
                                    </WrapPanel>
                                </Border>
                            </ControlTemplate>
                        </MenuItem.Template>
                    </MenuItem>
                </MenuItem>

                <MenuItem Header="Չափ">
                    <MenuItem Header="150 × 220"
                              Click="Size150x220_Click"/>
                    <MenuItem Header="300 × 220"
                              Click="Size300x220_Click"/>
                    <MenuItem Header="220 × 220"
                              Click="Size220x220_Click"/>
                </MenuItem>

                <Separator/>

                <MenuItem Header="Արտահանել Excel"
                          Click="ExportExcel_Click"/>

                <Separator/>

                <MenuItem Header="Օգնություն"
                          Click="HelpMenu_Click"/>

                <MenuItem Header="Ծրագրի մասին"
                          Click="AboutMenu_Click"/>

                <Separator/>

                <MenuItem x:Name="UndoDeleteMenuItem"
                          Header="Հետարկել"
                          InputGestureText="Ctrl+Z"
                          Click="UndoDelete_Click"
                          IsEnabled="False"/>

                <MenuItem x:Name="RedoMenuItem"
                          Header="Վերարկել"
                          InputGestureText="Ctrl+Y"
                          Click="Redo_Click"
                          IsEnabled="False"/>

                <MenuItem Header="Փակել"
                          InputGestureText="Ctrl+W"
                          Click="CloseMenu_Click"/>

            </ContextMenu>
        </Grid.ContextMenu>


        <!-- ===================================================== -->
        <!-- ԹԵՐԹԻԿ -->
        <!-- ===================================================== -->

        <Border x:Name="Note"
                MinWidth="140"
                MinHeight="80"
                Width="300"
                Height="220"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="300,300,0,0"
                Background="#FFF59D"
                CornerRadius="3"
                BorderThickness="0"

                MouseEnter="Note_MouseEnter"
                MouseLeave="Note_MouseLeave"
                MouseLeftButtonDown="Note_MouseLeftButtonDown"
                MouseMove="Note_MouseMove"
                MouseLeftButtonUp="Note_MouseLeftButtonUp"
                MouseRightButtonDown="Note_MouseRightButtonDown">

            <Border.RenderTransform>
                <RotateTransform x:Name="NoteRotation"
                                 Angle="0"/>
            </Border.RenderTransform>

            <Border.RenderTransformOrigin>
                <Point X="0.5"
                       Y="0"/>
            </Border.RenderTransformOrigin>

            <Border.Effect>
                <DropShadowEffect BlurRadius="12"
                                  ShadowDepth="4"
                                  Opacity="0.35"/>
            </Border.Effect>


            <Grid>

                <!-- ================================================= -->
<!-- ՎԵՐԵՒԻ ՀԻՄՆԱԿԱՆ ԳՈՏԻ -->
<!-- ================================================= -->
<Grid Height="12"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Top">

    <!-- Տեղափոխման գոտի -->
    <Border x:Name="MoveArea"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="Transparent"
            Cursor="SizeAll"
            MouseLeftButtonDown="MoveArea_MouseLeftButtonDown"/>

    <!-- Գամ (Pin) -->
    <Button x:Name="PinButton"
            Width="18"
            Height="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,-7,0,0"
            Background="Transparent"
            BorderThickness="0"
            Padding="0"
            FocusVisualStyle="{x:Null}"
            Visibility="Collapsed"
            Click="PinButton_Click"
            ToolTip="Ապագամել ամենավերեւից">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Image Source="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                       Width="18"
                       Height="20"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </ControlTemplate>
        </Button.Template>
    </Button>

    <!-- + եւ − -->
    <StackPanel x:Name="EditButtons"
                Orientation="Horizontal"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="0,-7,0,0"
                Visibility="Collapsed">

        <!-- + Նոր թերթիկ -->
        <Button x:Name="NewButton"
                Content="+"
                Width="25"
                Height="25"
                FontSize="18"
                Foreground="#555555"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                FocusVisualStyle="{x:Null}"
                Click="NewNote_Click">

            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </ControlTemplate>
            </Button.Template>

            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Foreground"
                            Value="#555555"/>
                    <Setter Property="FontWeight"
                            Value="Normal"/>

                    <Style.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter Property="Foreground"
                                    Value="Black"/>
                            <Setter Property="FontWeight"
                                    Value="ExtraBold"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- − Ջնջել -->
        <Button x:Name="DeleteButton"
                Content="−"
                Width="25"
                Height="25"
                Margin="-7,0,0,0"
                FontSize="18"
                Foreground="#555555"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                FocusVisualStyle="{x:Null}"
                IsEnabled="True"
                Click="DeleteButton_Click">

            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </ControlTemplate>
            </Button.Template>

            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Foreground"
                            Value="#555555"/>
                    <Setter Property="FontWeight"
                            Value="Normal"/>

                    <Style.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter Property="Foreground"
                                    Value="Black"/>
                            <Setter Property="FontWeight"
                                    Value="ExtraBold"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

<Button x:Name="CompleteButton"
        Content="✓"
        Width="25"
        Height="25"
        Margin="-7,0,0,0"
        FontSize="15"
        Foreground="#555555"
        Background="Transparent"
        BorderThickness="0"
        Padding="0"
        FocusVisualStyle="{x:Null}"
        MouseEnter="CompleteButton_MouseEnter"
        MouseLeave="CompleteButton_MouseLeave"
        Click="CompleteButton_Click"
        ToolTipService.Placement="Mouse"
        ToolTipService.ShowDuration="5000">

    <Button.Template>
        <ControlTemplate TargetType="Button">
            <ContentPresenter
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
        </ControlTemplate>
    </Button.Template>

</Button>

</StackPanel>
</Grid>


<!-- ================================================= -->
<!-- ԵՐԿՐՈՐԴ՝ ԱՐԱԳ ՁԵՒԱՎՈՐՄԱՆ ԳՈՐԾԻՔԱԳՈՏԻ -->
<!-- ================================================= -->

<Border x:Name="QuickToolbar"
        Height="24"
        Width="{Binding ActualWidth, ElementName=Note}"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Margin="5,8,0,0"
        Background="Transparent"
        Visibility="Collapsed">

    <Border.Resources>
        <Style x:Key="QuickArrowButton" TargetType="Button">
            <Setter Property="Width" Value="8.5"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Border.Resources>

    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">

        <!-- Թավ -->
        <Button x:Name="QuickBoldButton"
                Margin="0,0,0,0"
                Content="Թ"
                Width="16"
                Height="16"
                FontSize="14"
                FontWeight="Bold"
                Foreground="#555555"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                FocusVisualStyle="{x:Null}"
                Click="QuickBoldButton_Click"
                MouseEnter="QuickButton_MouseEnter"
                MouseLeave="QuickButton_MouseLeave">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>

                        <!-- Միայն hover-ի քառակուսին՝ 2 px ներքեւ -->
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <Border.RenderTransform>
                                <TranslateTransform Y="2"/>
                            </Border.RenderTransform>
                        </Border>

                        <!-- B-ն չի շարժվում -->
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                    </Grid>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Շեղ -->
        <Button x:Name="QuickItalicButton"
                Content="Շ"
                Width="16"
                Height="16"
                FontSize="14"
                FontStyle="Italic"
                Foreground="#555555"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                FocusVisualStyle="{x:Null}"
                Click="QuickItalicButton_Click"
                MouseEnter="QuickButton_MouseEnter"
                MouseLeave="QuickButton_MouseLeave">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>

                        <!-- Միայն hover-ի քառակուսին՝ 2 px ներքեւ -->
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <Border.RenderTransform>
                                <TranslateTransform Y="2"/>
                            </Border.RenderTransform>
                        </Border>

                        <!-- B-ն չի շարժվում -->
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                    </Grid>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- ՏԵՔՍՏԻ ԳՈՒՅՆ -->
        <Button x:Name="QuickTextColorButton"
        Margin="0,4,0,0"
        Width="16"
        Height="16"
        Background="Transparent"
        BorderThickness="0"
        Padding="0"
        FocusVisualStyle="{x:Null}"
        Click="QuickTextColorButton_Click"
        MouseEnter="QuickButton_MouseEnter"
        MouseLeave="QuickButton_MouseLeave"
        ToolTip="Տեքստի գույն">

    <Button.Template>
        <ControlTemplate TargetType="Button">
            <Grid>

                <!-- Hover-ի քառակուսին -->
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="5">
                    <Border.RenderTransform>
                        <TranslateTransform Y="0"/>
                    </Border.RenderTransform>
                </Border>

                <!-- Գույնի քառակուսին -->
                <Border x:Name="QuickTextColorPreview"
                        Width="11"
                        Height="11"
                        Background="#000000"
                        BorderBrush="#555555"
                        BorderThickness="1"
                        CornerRadius="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                <!-- Խառը գույնի ցուցիչ -->
                <Ellipse x:Name="MixedColorIndicator"
                         Width="3"
                         Height="3"
                         Fill="#555555"
                         Visibility="Collapsed"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>

            </Grid>
        </ControlTemplate>
    </Button.Template>

</Button>

        <Popup x:Name="TextColorPalettePopup"
               AllowsTransparency="True"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=QuickTextColorButton}"
               Closed="TextColorPalettePopup_Closed"
               StaysOpen="False">
            <Border Margin="0,4,0,0"
                    Padding="0"
                    Background="White"
                    BorderBrush="#D0D0D0"
                    BorderThickness="1"
                    CornerRadius="2">
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style x:Key="PaletteColorButton" TargetType="Button">
                            <Setter Property="Width" Value="14"/>
                            <Setter Property="Height" Value="14"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="3">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#25000000"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style x:Key="MoreColorsButton" TargetType="Button">
                            <Setter Property="Height" Value="14"/>
                            <Setter Property="Margin" Value="4,0,0,0"/>
                            <Setter Property="Padding" Value="4,0"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="2">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Margin="0,-1,0,1"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#25000000"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </StackPanel.Resources>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#000000" Click="PaletteColor_Click" ToolTip="Սեւ"><Border Width="10" Height="10" Background="#000000" CornerRadius="1"/></Button>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#FFFFFF" Click="PaletteColor_Click" ToolTip="Սպիտակ"><Border Width="11" Height="11" Background="#FFFFFF" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="1"/></Button>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#868686" Click="PaletteColor_Click" ToolTip="Գորշ"><Border Width="10" Height="10" Background="#868686" CornerRadius="1"/></Button>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#ff0000" Click="PaletteColor_Click" ToolTip="Կարմիր"><Border Width="10" Height="10" Background="#ff0000" CornerRadius="1"/></Button>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#ffc000" Click="PaletteColor_Click" ToolTip="Նարինջ"><Border Width="10" Height="10" Background="#ffc000" CornerRadius="1"/></Button>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#ffff00" Click="PaletteColor_Click" ToolTip="Դեղին"><Border Width="10" Height="10" Background="#ffff00" CornerRadius="1"/></Button>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#00b050" Click="PaletteColor_Click" ToolTip="Կանաչ"><Border Width="10" Height="10" Background="#00b050" CornerRadius="1"/></Button>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#0000ff" Click="PaletteColor_Click" ToolTip="Կապույտ"><Border Width="10" Height="10" Background="#0000ff" CornerRadius="1"/></Button>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#8a00ff" Click="PaletteColor_Click" ToolTip="Մանուշ"><Border Width="10" Height="10" Background="#8a00ff" CornerRadius="1"/></Button>
                    <Button Style="{StaticResource MoreColorsButton}"
                            Click="CustomTextColor_Click"
                            ToolTip="Այլ…">
                        <TextBlock Text="»"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.RenderTransform>
                                <TranslateTransform Y="-2"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <!-- 1. ՏԱՌԱՉԱՓ -->
        <StackPanel Orientation="Horizontal"
                    Margin="3,0,0,0"
                    VerticalAlignment="Center"
                    ToolTip="Տառաչափ">
            <TextBlock Text="Տ"
                       FontSize="14"
                       FontWeight="Regular"
                       Foreground="#555555"
                       VerticalAlignment="Center"
                       Margin="0,2,0,0"/>
            <StackPanel Orientation="Vertical"
                        VerticalAlignment="Center"
                        Margin="0.5,1,0,0">
                <Button x:Name="QuickFontSizeIncreaseButton"
                        Style="{StaticResource QuickArrowButton}"
                        Margin="0,2,0,0"
                        ToolTip="Մեծացնել տառաչափը"
                        Click="QuickFontSizeIncrease_Click"
                        MouseEnter="QuickButton_MouseEnter"
                        MouseLeave="QuickButton_MouseLeave">
                    <Path Data="M 0,3.8 L 3.5,0 L 7,3.8 Z"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Stretch="Uniform"
                          Width="7"
                          Height="3.8"/>
                </Button>
                <Button x:Name="QuickFontSizeDecreaseButton"
                        Style="{StaticResource QuickArrowButton}"
                        Margin="0,0.5,0,0"
                        ToolTip="Փոքրացնել տառաչափը"
                        Click="QuickFontSizeDecrease_Click"
                        MouseEnter="QuickButton_MouseEnter"
                        MouseLeave="QuickButton_MouseLeave">
                    <Path Data="M 0,0 L 7,0 L 3.5,3.8 Z"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Stretch="Uniform"
                          Width="7"
                          Height="3.8"/>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- 2. ՏՈՂԱՄԻՋՅԱՆ ՀԵՌԱՎՈՐՈՒԹՅՈՒՆ -->
        <StackPanel Orientation="Horizontal"
                    Margin="3,0,0,0"
                    VerticalAlignment="Center"
                    ToolTip="Տողամիջյան հեռավորություն">
            <TextBlock Text="≣"
                       FontSize="14"
                       Foreground="#555555"
                       VerticalAlignment="Center"
                       Margin="0,0,0,0"/>
            <StackPanel Orientation="Vertical"
                        VerticalAlignment="Center"
                        Margin="0.5,1,0,0">
                <Button x:Name="QuickLineSpacingIncreaseButton"
                        Style="{StaticResource QuickArrowButton}"
                        Margin="0,2,0,0"
                        ToolTip="Մեծացնել տողամիջոցը"
                        Click="QuickLineSpacingIncrease_Click"
                        MouseEnter="QuickButton_MouseEnter"
                        MouseLeave="QuickButton_MouseLeave">
                    <Path Data="M 0,3.8 L 3.5,0 L 7,3.8 Z"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Stretch="Uniform"
                          Width="7"
                          Height="3.8"/>
                </Button>
                <Button x:Name="QuickLineSpacingDecreaseButton"
                        Style="{StaticResource QuickArrowButton}"
                        Margin="0,0.5,0,0"
                        ToolTip="Փոքրացնել տողամիջոցը"
                        Click="QuickLineSpacingDecrease_Click"
                        MouseEnter="QuickButton_MouseEnter"
                        MouseLeave="QuickButton_MouseLeave">
                    <Path Data="M 0,0 L 7,0 L 3.5,3.8 Z"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Stretch="Uniform"
                          Width="7"
                          Height="3.8"/>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- 3. ՊԱՐԲԵՐՈՒԹՅՈՒՆՆԵՐԻ ՀԵՌԱՎՈՐՈՒԹՅՈՒՆ -->
        <StackPanel Orientation="Horizontal"
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    ToolTip="Պարբերությունների հեռավորություն">
            <TextBlock Text="¶"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="#555555"
                       VerticalAlignment="Center"
                       Margin="0,2,0,0"/>
            <StackPanel Orientation="Vertical"
                        VerticalAlignment="Center"
                        Margin="1.5,1,0,0">
                <Button x:Name="QuickParagraphSpacingIncreaseButton"
                        Style="{StaticResource QuickArrowButton}"
                        Margin="0,2,0,0"
                        ToolTip="Մեծացնել պարբերությունների հեռավորությունը"
                        Click="QuickParagraphSpacingIncrease_Click"
                        MouseEnter="QuickButton_MouseEnter"
                        MouseLeave="QuickButton_MouseLeave">
                    <Path Data="M 0,3.8 L 3.5,0 L 7,3.8 Z"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Stretch="Uniform"
                          Width="7"
                          Height="3.8"/>
                </Button>
                <Button x:Name="QuickParagraphSpacingDecreaseButton"
                        Style="{StaticResource QuickArrowButton}"
                        Margin="0,0.5,0,0"
                        ToolTip="Փոքրացնել պարբերությունների հեռավորությունը"
                        Click="QuickParagraphSpacingDecrease_Click"
                        MouseEnter="QuickButton_MouseEnter"
                        MouseLeave="QuickButton_MouseLeave">
                    <Path Data="M 0,0 L 7,0 L 3.5,3.8 Z"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Stretch="Uniform"
                          Width="7"
                          Height="3.8"/>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- 4. ՄԱՏԻՏ -->
        <Button x:Name="QuickPencilButton"
                Margin="4,2,0,0"
                Width="16"
                Height="16"
                ToolTip="Մատիտ (Ctrl+P)"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="1"
                Padding="0"
                FocusVisualStyle="{x:Null}"
                Click="QuickPencilButton_Click"
                MouseEnter="QuickButton_MouseEnter"
                MouseLeave="QuickButton_MouseLeave">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="PencilBg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"/>
                        <Path x:Name="PencilPath"
                              Data="M 11.5,1.5 L 14.5,4.5 L 5.5,13.5 L 2.5,14.5 L 3.5,11.5 Z M 9.5,3.5 L 12.5,6.5"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2"
                              Stretch="Uniform"
                              Width="12"
                              Height="12"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Popup x:Name="PencilColorPalettePopup"
               AllowsTransparency="True"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=QuickPencilButton}"
               Closed="PencilColorPalettePopup_Closed"
               StaysOpen="False">
            <Border Margin="0,4,0,0"
                    Padding="0"
                    Background="White"
                    BorderBrush="#D0D0D0"
                    BorderThickness="1"
                    CornerRadius="2">
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style x:Key="PencilPaletteColorButton" TargetType="Button">
                            <Setter Property="Width" Value="14"/>
                            <Setter Property="Height" Value="14"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="3">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#25000000"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style x:Key="PencilMoreColorsButton" TargetType="Button">
                            <Setter Property="Height" Value="14"/>
                            <Setter Property="Margin" Value="4,0,0,0"/>
                            <Setter Property="Padding" Value="4,0"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="2">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Margin="0,-1,0,1"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#25000000"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </StackPanel.Resources>
                    <Button Style="{StaticResource PencilPaletteColorButton}" Tag="#000000" Click="PencilPaletteColor_Click" ToolTip="Սեւ"><Border Width="10" Height="10" Background="#000000" CornerRadius="1"/></Button>
                    <Button Style="{StaticResource PencilPaletteColorButton}" Tag="#FFFFFF" Click="PencilPaletteColor_Click" ToolTip="Սպիտակ"><Border Width="11" Height="11" Background="#FFFFFF" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="1"/></Button>
                    <Button Style="{StaticResource PencilPaletteColorButton}" Tag="#868686" Click="PencilPaletteColor_Click" ToolTip="Գորշ"><Border Width="10" Height="10" Background="#868686" CornerRadius="1"/></Button>
                    <Button Style="{StaticResource PencilPaletteColorButton}" Tag="#ff0000" Click="PencilPaletteColor_Click" ToolTip="Կարմիր"><Border Width="10" Height="10" Background="#ff0000" CornerRadius="1"/></Button>
                    <Button Style="{StaticResource PencilPaletteColorButton}" Tag="#ffc000" Click="PencilPaletteColor_Click" ToolTip="Նարինջ"><Border Width="10" Height="10" Background="#ffc000" CornerRadius="1"/></Button>
                    <Button Style="{StaticResource PencilPaletteColorButton}" Tag="#ffff00" Click="PencilPaletteColor_Click" ToolTip="Դեղին"><Border Width="10" Height="10" Background="#ffff00" CornerRadius="1"/></Button>
                    <Button Style="{StaticResource PencilPaletteColorButton}" Tag="#00b050" Click="PencilPaletteColor_Click" ToolTip="Կանաչ"><Border Width="10" Height="10" Background="#00b050" CornerRadius="1"/></Button>
                    <Button Style="{StaticResource PencilPaletteColorButton}" Tag="#0000ff" Click="PencilPaletteColor_Click" ToolTip="Կապույտ"><Border Width="10" Height="10" Background="#0000ff" CornerRadius="1"/></Button>
                    <Button Style="{StaticResource PencilPaletteColorButton}" Tag="#8a00ff" Click="PencilPaletteColor_Click" ToolTip="Մանուշ"><Border Width="10" Height="10" Background="#8a00ff" CornerRadius="1"/></Button>
                    <Button Style="{StaticResource PencilMoreColorsButton}"
                            Click="CustomPencilColor_Click"
                            ToolTip="Այլ…">
                        <TextBlock Text="»"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.RenderTransform>
                                <TranslateTransform Y="-2"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

    </StackPanel>
</Border>


<!-- ================================================= -->
<!-- ԵՐԿՐՈՐԴ ՀՈՒՎԵՐԱՅԻՆ ԳՈՏԻ -->
<!-- ================================================= -->



                <!-- ================================================= -->
                <!-- ՏԵՔՍՏ ԵՒ ՄԱՏԻՏԻ ԹԱՓԱՆՑԻԿ ՇԵՐՏ -->
                <!-- ================================================= -->

                <Grid Margin="4,30,4,12">
                    <RichTextBox x:Name="NoteText"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch"
                                 TextChanged="NoteText_TextChanged"
                                 SelectionChanged="NoteText_SelectionChanged"
                                 FontFamily="Comic Sans MS"
                                 FontSize="14"
                                 Foreground="#222222"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 VerticalScrollBarVisibility="Hidden"
                                 HorizontalScrollBarVisibility="Hidden"
                                 AcceptsReturn="True"
                                 Cursor="IBeam"
                                 ContextMenu="{x:Null}"
                                 IsInactiveSelectionHighlightEnabled="True"
                                 SelectionBrush="#7e8fac"
                                 SelectionOpacity="0.5"
                                 MouseRightButtonDown="NoteText_MouseRightButtonDown"
                                 PreviewMouseLeftButtonDown="NoteText_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="NoteText_PreviewMouseMove"
                                 PreviewMouseLeftButtonUp="NoteText_PreviewMouseLeftButtonUp"/>

                    <InkCanvas x:Name="NoteInkCanvas"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"
                               Background="Transparent"
                               UseCustomCursor="True"
                               IsHitTestVisible="False"
                               EditingMode="None"/>
                </Grid>


                <!-- ================================================= -->
                <!-- ՓԱԿԵԼՈՒ × -->
                <!-- ================================================= -->

                <Button x:Name="CloseButton"
                        Content="×"
                        Width="25"
                        Height="25"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,-8,-5,0"
                        FontSize="18"
                        Foreground="#555555"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        FocusVisualStyle="{x:Null}"
                        Visibility="Collapsed"
                        IsHitTestVisible="True"
                        MouseEnter="CloseButton_MouseEnter"
                        MouseLeave="CloseButton_MouseLeave"
                        Click="CloseButton_Click"
                        ToolTip="Փակել թերթիկը">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </ControlTemplate>
                    </Button.Template>

                    <Button.Style>
                        <Style TargetType="Button">

                            <Setter Property="Foreground"
                                    Value="#555555"/>

                            <Style.Triggers>

                                <Trigger Property="IsMouseOver"
                                         Value="True">

                                    <Setter Property="Foreground"
                                            Value="Black"/>

                                    <Setter Property="FontWeight"
                                            Value="ExtraBold"/>

                                </Trigger>

                            </Style.Triggers>

                        </Style>
                    </Button.Style>

                </Button>

                <!-- ================================================= -->
                <!-- ՏՐՑԱԿԻ ԹԵՐԹՄԱՆ ԳՈՏԻ (STACK NAVIGATION) -->
                <!-- ================================================= -->
                <Border x:Name="StackNavigationBar"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,3"
                        Background="Transparent"
                        Padding="0"
                        Visibility="Collapsed"
                        MouseEnter="StackNavigationBar_MouseEnter"
                        MouseLeave="StackNavigationBar_MouseLeave">
                    <Border.Resources>
                        <Style x:Key="StackNavArrowButton" TargetType="Button">
                            <Setter Property="Width" Value="14"/>
                            <Setter Property="Height" Value="16"/>
                            <Setter Property="FontSize" Value="16"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Foreground" Value="#444444"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="2">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Margin="0,-4,0,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Border.Resources>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="StackFirstButton"
                                Style="{StaticResource StackNavArrowButton}"
                                Content="«"
                                Click="StackFirst_Click"
                                MouseEnter="StackNavButton_MouseEnter"
                                MouseLeave="StackNavButton_MouseLeave"
                                ToolTip="Ամենահին թերթիկ (առաջին)"/>
                        <Button x:Name="StackPrevButton"
                                Style="{StaticResource StackNavArrowButton}"
                                Content="‹"
                                Click="StackPrev_Click"
                                MouseEnter="StackNavButton_MouseEnter"
                                MouseLeave="StackNavButton_MouseLeave"
                                ToolTip="Նախորդ թերթիկ (հին)"/>
                        <TextBlock x:Name="StackPageIndicator"
                                   Text="1 / 1"
                                   FontSize="10"
                                   Foreground="#333333"
                                   VerticalAlignment="Center"
                                   Margin="3,0"/>
                        <Button x:Name="StackNextButton"
                                Style="{StaticResource StackNavArrowButton}"
                                Content="›"
                                Click="StackNext_Click"
                                MouseEnter="StackNavButton_MouseEnter"
                                MouseLeave="StackNavButton_MouseLeave"
                                ToolTip="Հաջորդ թերթիկ (նոր)"/>
                        <Button x:Name="StackLastButton"
                                Style="{StaticResource StackNavArrowButton}"
                                Content="»"
                                Click="StackLast_Click"
                                MouseEnter="StackNavButton_MouseEnter"
                                MouseLeave="StackNavButton_MouseLeave"
                                ToolTip="Ամենանոր թերթիկ (վերջին)"/>
                    </StackPanel>
                </Border>

                <!-- ================================================= -->
                <!-- ԱԶԱՏ ՉԱՓԱՓՈԽՄԱՆ ԱՆԿՅՈՒՆ (RESIZE GRIP) -->
                <!-- ================================================= -->
                <Border x:Name="ResizeGrip"
                        Width="14"
                        Height="14"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Background="Transparent"
                        Cursor="SizeNWSE"
                        Visibility="Collapsed"
                        MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
                        MouseMove="ResizeGrip_MouseMove"
                        MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"
                        ToolTip="Փոխել չափը">
                    <Path Data="M 11 14 L 14 11 M 7 14 L 14 7 M 3 14 L 14 3"
                          Stroke="#888888"
                          StrokeThickness="1"
                          Opacity="0.5"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"
                          Margin="0,0,2,2"/>
                </Border>

            </Grid>

        </Border>

    </Grid>

</Window>
