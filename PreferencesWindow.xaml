<Window x:Class="Hushak.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Hushak"
        Title="{loc:Loc PreferencesTitle}"
        Width="740"
        Height="680"
        MinWidth="640"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <!-- Փոքր հեռացման կոճակի ոճ -->
        <Style x:Key="SmallRemoveButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="{loc:Loc RemoveFromListTooltip}"/>
        </Style>

        <!-- Գույնի ընտրության կոճակի ոճ -->
        <Style x:Key="ColorPickerButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- ՆԱԽԸՆՏՐՈՒԹՅՈՒՆՆԵՐԻ ՍՊԻՏԱԿ ԳՈՏԻ -->
        <!-- ================================================= -->

        <Border Grid.Row="0"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                Background="White"
                CornerRadius="3"
                Padding="18,14">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel>

                    <!-- ================================ -->
                    <!-- 1. ԼԵԶՈՒ (LANGUAGE) -->
                    <!-- ================================ -->

                    <TextBlock Text="{loc:Loc LanguageSection}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#333333"
                               Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Լեզվի ընտրություն -->
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="{loc:Loc LanguageLabel}"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>

                        <ComboBox x:Name="LanguageComboBox"
                                  Grid.Row="0"
                                  Grid.Column="1"
                                  Width="220"
                                  Height="26"
                                  FontSize="12"
                                  HorizontalAlignment="Left"
                                  SelectionChanged="LanguageComboBox_SelectionChanged"/>

                        <!-- AI translation note -->
                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{loc:Loc AiNoticeShort}"
                                   FontSize="11"
                                   Foreground="#777777"
                                   Margin="0,6,0,0"/>
                    </Grid>

                    <Separator Margin="0,0,0,14" Background="#EBEBEB"/>

                    <!-- ================================ -->
                    <!-- 2. ԱՐԴԻԱՑՈՒՄՆԵՐ (UPDATES) -->
                    <!-- ================================ -->

                    <TextBlock Text="{loc:Loc UpdatesSection}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#333333"
                               Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="{loc:Loc UpdateSourceLabel}"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="tarumian.am"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#0066CC"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>

                            <Button x:Name="CheckUpdatesPrefButton"
                                    Content="{loc:Loc CheckUpdatesButton}"
                                    Height="26"
                                    Padding="10,0"
                                    Background="#F7F7F7"
                                    BorderBrush="#C5C5C5"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Click="CheckUpdatesPrefButton_Click"/>
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,0,0,14" Background="#EBEBEB"/>

                    <!-- ================================ -->
                    <!-- 3. ԹԵՐԹԻԿ -->
                    <!-- ================================ -->

                    <TextBlock Text="{loc:Loc NoteSection}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#333333"
                               Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Չափ -->
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="{loc:Loc NewNoteSizeLabel}"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <ComboBox x:Name="NoteSizeComboBox"
                                      Width="220"
                                      Height="26"
                                      FontSize="12"
                                      HorizontalAlignment="Left"
                                      SelectionChanged="NoteSizeComboBox_SelectionChanged"/>
                            <Button x:Name="RemoveSizeButton"
                                    Content="✕"
                                    Style="{StaticResource SmallRemoveButtonStyle}"
                                    Click="RemoveSizeButton_Click"/>
                        </StackPanel>

                        <!-- Թերթիկի գույն -->
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="{loc:Loc NoteColorLabel}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,10,0,0"/>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,10,0,0">

                            <ComboBox x:Name="NoteColorComboBox"
                                      Width="220"
                                      Height="26"
                                      FontSize="12"
                                      SelectionChanged="NoteColorComboBox_SelectionChanged"/>

                            <Button x:Name="RemoveNoteColorButton"
                                    Content="✕"
                                    Style="{StaticResource SmallRemoveButtonStyle}"
                                    Click="RemoveNoteColorButton_Click"/>
                        </StackPanel>

                        <!-- Տեքստի գույն -->
                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="{loc:Loc TextColorLabel}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,10,0,0"/>

                        <StackPanel Grid.Row="2"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,10,0,0">

                            <ComboBox x:Name="TextColorComboBox"
                                      Width="220"
                                      Height="26"
                                      FontSize="12"
                                      SelectionChanged="TextColorComboBox_SelectionChanged"/>

                            <Button x:Name="RemoveTextColorButton"
                                    Content="✕"
                                    Style="{StaticResource SmallRemoveButtonStyle}"
                                    Click="RemoveTextColorButton_Click"/>
                        </StackPanel>

                        <!-- Տրցակի հավասարեցում -->
                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Text="{loc:Loc StackAlignmentLabel}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,10,0,0"/>

                        <ComboBox x:Name="StackAlignmentComboBox"
                                  Grid.Row="3"
                                  Grid.Column="1"
                                  Width="220"
                                  Height="26"
                                  FontSize="12"
                                  HorizontalAlignment="Left"
                                  Margin="0,10,0,0">
                            <ComboBoxItem Content="{loc:Loc StackAlignTopCenterOpt}" Tag="TopCenter"/>
                            <ComboBoxItem Content="{loc:Loc StackAlignTopLeftOpt}" Tag="TopLeft"/>
                            <ComboBoxItem Content="{loc:Loc StackAlignTopRightOpt}" Tag="TopRight"/>
                        </ComboBox>

                        <!-- Պտտման/չափափոխման կետ -->
                        <TextBlock Grid.Row="4"
                                   Grid.Column="0"
                                   Text="{loc:Loc RotationOriginLabel}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,10,0,0"/>

                        <ComboBox x:Name="RotationOriginComboBox"
                                  Grid.Row="4"
                                  Grid.Column="1"
                                  Width="220"
                                  Height="26"
                                  FontSize="12"
                                  HorizontalAlignment="Left"
                                  Margin="0,10,0,0">
                            <ComboBoxItem Content="{loc:Loc RotationOriginTopCenterOpt}" Tag="TopCenter"/>
                            <ComboBoxItem Content="{loc:Loc RotationOriginTopLeftOpt}" Tag="TopLeft"/>
                        </ComboBox>

                        <!-- Ազատ մեծացում -->
                        <CheckBox x:Name="AllowFreeResizeCheckBox"
                                  Grid.Row="5"
                                  Grid.Column="1"
                                  Content="{loc:Loc AllowFreeResizeLabel}"
                                  FontSize="12"
                                  Margin="0,12,0,0"/>

                        <!-- Պատահական թեքում նոր թերթիկների համար -->
                        <CheckBox x:Name="RandomRotationCheckBox"
                                  Grid.Row="6"
                                  Grid.Column="1"
                                  Content="{loc:Loc RandomRotationLabel}"
                                  FontSize="12"
                                  Margin="0,10,0,0"/>

                    </Grid>

                    <Separator Margin="0,0,0,14" Background="#EBEBEB"/>

                    <!-- ================================ -->
                    <!-- 4. ՏԱՌԱՏԵՍԱԿ -->
                    <!-- ================================ -->

                    <TextBlock Text="{loc:Loc FontSection}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#333333"
                               Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Ընտանիք -->
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="{loc:Loc FontFamilyLabel}"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>

                        <ComboBox x:Name="FontFamilyComboBox"
                                  Grid.Row="0"
                                  Grid.Column="1"
                                  Width="220"
                                  Height="26"
                                  FontSize="12"
                                  HorizontalAlignment="Left"
                                  SelectionChanged="FontFamilyComboBox_SelectionChanged"/>

                        <!-- Կետաչափ -->
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="{loc:Loc FontSizeLabel}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,10,0,0"/>

                        <TextBox x:Name="FontSizeTextBox"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Width="70"
                                 Height="26"
                                 FontSize="12"
                                 Padding="6,2"
                                 HorizontalAlignment="Left"
                                 Text="14"
                                 Margin="0,10,0,0"
                                 TextChanged="FontInput_Changed"/>

                        <!-- Ոճ -->
                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="{loc:Loc FontStyleLabel}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,10,0,0"/>

                        <ComboBox x:Name="FontStyleComboBox"
                                  Grid.Row="2"
                                  Grid.Column="1"
                                  Width="150"
                                  Height="26"
                                  FontSize="12"
                                  HorizontalAlignment="Left"
                                  SelectedIndex="0"
                                  Margin="0,10,0,0"
                                  SelectionChanged="FontInput_Changed">
                            <ComboBoxItem Content="{loc:Loc StyleRegular}"/>
                            <ComboBoxItem Content="{loc:Loc StyleBold}"/>
                            <ComboBoxItem Content="{loc:Loc StyleItalic}"/>
                            <ComboBoxItem Content="{loc:Loc StyleBoldItalic}"/>
                        </ComboBox>

                        <!-- Նախադիտում -->
                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Text="{loc:Loc PreviewLabel}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,10,0,0"/>

                        <Border Grid.Row="3"
                                Grid.Column="1"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                Background="#FAFAFA"
                                CornerRadius="2"
                                Height="45"
                                Padding="8,4"
                                Margin="0,10,0,0"
                                Width="280"
                                HorizontalAlignment="Left">
                            <TextBlock x:Name="FontPreviewTextBlock"
                                       Text="{loc:Loc PreviewSampleText}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>

                    </Grid>

                    <Separator Margin="0,0,0,14" Background="#EBEBEB"/>

                    <!-- ================================ -->
                    <!-- 5. ՄԱՏԻՏ -->
                    <!-- ================================ -->

                    <TextBlock Text="{loc:Loc PencilSection}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#333333"
                               Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Գույն -->
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="{loc:Loc PencilColorLabel}"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <ComboBox x:Name="PencilColorComboBox"
                                      Width="220"
                                      Height="26"
                                      FontSize="12"
                                      SelectionChanged="PencilColorComboBox_SelectionChanged"/>

                            <Button x:Name="RemovePencilColorButton"
                                    Content="✕"
                                    Style="{StaticResource SmallRemoveButtonStyle}"
                                    Click="RemovePencilColorButton_Click"/>
                        </StackPanel>

                        <!-- Հաստություն -->
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="{loc:Loc PencilThicknessLabel}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,10,0,0"/>

                        <TextBox x:Name="PencilThicknessTextBox"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Width="70"
                                 Height="26"
                                 FontSize="12"
                                 Padding="6,2"
                                 HorizontalAlignment="Left"
                                 Text="2"
                                 Margin="0,10,0,0"/>

                    </Grid>

                    <Separator Margin="0,0,0,14" Background="#EBEBEB"/>

                    <!-- ================================ -->
                    <!-- 6. ՎԱՐՔԱԳԻԾ -->
                    <!-- ================================ -->

                    <TextBlock Text="{loc:Loc BehaviorSection}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#333333"
                               Margin="0,0,0,10"/>

                    <CheckBox x:Name="AutostartCheckBox"
                              Content="{loc:Loc AutostartCheckbox}"
                              FontSize="12"
                              IsChecked="True"
                              Margin="0,0,0,8"/>

                    <CheckBox x:Name="ApplyToOpenNotesCheckBox"
                              Content="{loc:Loc ApplyToOpenNotesCheckbox}"
                              FontSize="12"
                              IsChecked="False"
                              Margin="0,0,0,6"/>

                </StackPanel>

            </ScrollViewer>

        </Border>


        <!-- ================================================= -->
        <!-- ՆԵՐՔԵՒԻ ԿՈՃԱԿՆԵՐ -->
        <!-- ================================================= -->

        <Grid Grid.Row="1"
              Margin="0,12,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="SaveButton"
                    Grid.Column="1"
                    Content="{loc:Loc Save}"
                    Width="90"
                    Height="30"
                    IsDefault="True"
                    Click="SaveButton_Click"/>

            <Button x:Name="CancelButton"
                    Grid.Column="3"
                    Content="{loc:Loc Cancel}"
                    Width="90"
                    Height="30"
                    IsCancel="True"
                    Click="CancelButton_Click"/>

        </Grid>

    </Grid>

</Window>