<Window x:Class="Hushak.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Hushak"
        Title="{loc:Loc About}"
        Width="490"
        Height="410"
        MinWidth="420"
        MinHeight="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F7F7F7">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Վերնագիր և պատկերակ -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16,12"
                Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="Assets/Hushak.ico"
                       Width="44"
                       Height="44"
                       Margin="0,0,16,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="AppNameTextBlock"
                                   Text="Հուշակ"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#222222"/>
                    </StackPanel>
                    <TextBlock x:Name="VersionTextBlock"
                               FontSize="12"
                               Foreground="#777777"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Նկարագրության և տեղեկությունների դաշտ -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16,12"
                Margin="0,0,0,14">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="{loc:Loc AppDescription}"
                               FontSize="12.5"
                               TextWrapping="Wrap"
                               LineHeight="18"
                               Foreground="#333333"
                               Margin="0,0,0,10"/>

                    <!-- AI Translation Badge / Notice -->
                    <Border x:Name="AiNoticeBorder"
                            Background="#F0F7FF"
                            BorderBrush="#CCE2FF"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,6"
                            Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="ℹ️ " FontSize="12" Margin="0,0,4,0"/>
                            <TextBlock Text="{loc:Loc AiTranslationNotice}"
                                       FontSize="11.5"
                                       Foreground="#00529B"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Separator Margin="0,2,0,10" Background="#EEEEEE"/>

                    <TextBlock Text="{loc:Loc Author}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#444444"
                               Margin="0,0,0,4"/>

                    <TextBlock Margin="0,0,0,4" FontSize="11.5">
                        <Hyperlink NavigateUri="https://tarumian.am" RequestNavigate="WebsiteLink_RequestNavigate">
                            tarumian.am
                        </Hyperlink>
                    </TextBlock>

                    <TextBlock Text="{loc:Loc Copyright}"
                               FontSize="11.5"
                               Foreground="#888888"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Կոճակներ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Ստուգել արդիացումներ -->
            <Button x:Name="CheckUpdatesButton"
                    Grid.Column="0"
                    Content="{loc:Loc CheckUpdatesButton}"
                    Height="28"
                    Padding="12,0"
                    Background="#FFFFFF"
                    BorderBrush="#C5C5C5"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="CheckUpdatesButton_Click"/>

            <!-- Փակել կոճակ -->
            <Button Grid.Column="2"
                    Content="{loc:Loc Close}"
                    Width="90"
                    Height="28"
                    IsDefault="True"
                    IsCancel="True"
                    Background="#FFFFFF"
                    BorderBrush="#C5C5C5"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>
